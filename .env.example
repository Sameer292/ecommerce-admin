SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Use the PostgreSQL connection string from the same Supabase project.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Set a direct or session pooler URL here if the app uses the transaction pooler.
# DATABASE_MIGRATION_URL=
STORE_NAME=Commerce
STORE_CURRENCY=USD
STORE_TIME_ZONE=UTC
# Generate a separate random token to enable server-to-server storefront integration.
# STORE_INTEGRATION_TOKEN=
# Set these when running bun run admin:create.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store owner
STORE_INVENTORY_AUTHORITY=unverified
